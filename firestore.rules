rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getEmployeeData() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data;
    }

    function isActiveEmployee() {
      return isAuthenticated() && getEmployeeData().accountStatus == 'ACTIVE';
    }

    function isAdmin() {
      return isActiveEmployee() && getEmployeeData().role == 'ADMIN';
    }

    // Employees Collection
    match /employees/{employeeUid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(employeeUid)
                    && request.resource.data.accountStatus == 'PENDING_APPROVAL'
                    && request.resource.data.role == 'EMPLOYEE';
      allow update: if isAdmin() || (
        isOwner(employeeUid) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.accountStatus == resource.data.accountStatus
      );
      allow delete: if isAdmin();
    }

    // Customer Visits Collection (Shared records)
    match /customer_visits/{recordId} {
      allow read: if isActiveEmployee();
      allow create: if isActiveEmployee();
      allow update: if isActiveEmployee();
      allow delete: if isAdmin();
    }

    // Customer Visit History
    match /customer_visit_history/{historyId} {
      allow read: if isActiveEmployee();
      allow create: if isActiveEmployee();
      allow update, delete: if isAdmin();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isActiveEmployee();
      allow update, delete: if false;
    }

    // App Settings (Dropdown options)
    match /app_settings/{settingId} {
      allow read: if isActiveEmployee();
      allow write: if isAdmin();
    }
  }
}
